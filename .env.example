# SMM Platforma — .env namunasi. Nusxa oling:  cp .env.example .env  va qiymatlarni to'ldiring.
# HECH QACHON .env ni GitHub'ga yuklamang.

# 32+ belgili tasodifiy kalit:  python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Fernet kalit(lar) (vergul bilan; birinchisi shifrlaydi, hammasi ochadi). YO'QOTMANG — alohida joyda nusxa saqlang!
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEYS=

DB_ENGINE=mysql          # mysql | sqlite
DB_NAME=smm_platform
DB_USER=smm
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

HOST=0.0.0.0
PORT=8765
# Aniq domen(lar): vergul bilan, '*' mumkin emas
ALLOWED_HOSTS=smm.example.uz
CSRF_TRUSTED_ORIGINS=https://smm.example.uz
PUBLIC_BASE_URL=https://smm.example.uz
# Nginx + HTTPS ortida ishlaganda 1 qiling (secure cookie, HSTS, proxy sarlavhalari)
HTTPS=1
USE_FAKES=0
DEBUG=0
