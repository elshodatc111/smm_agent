# SMM Platforma — .env namunasi. run.bat birinchi ishga tushganda buni o'zi yaratadi.
SECRET_KEY=change-me
# Fernet kalit(lar): vergul bilan; birinchisi shifrlaydi, hammasi ochadi. YO'QOTMANG (alohida joyda nusxa saqlang)!
FERNET_KEYS=
DB_ENGINE=mysql          # mysql | sqlite
DB_NAME=smm_platform
DB_USER=smm
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=*
PUBLIC_BASE_URL=http://192.168.1.10:8000
USE_FAKES=0
DEBUG=0
